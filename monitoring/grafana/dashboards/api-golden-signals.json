                "x": 0,
                "y": 14
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (status) (rate(django_http_responses_total_by_status_total[5m]))",
                    "legendFormat": "status {{status}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "showLegend": true,
                    "displayMode": "table",
                    "placement": "bottom"
